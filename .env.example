# GitHub API (recommended for higher rate limits)
GITHUB_TOKEN=ghp_your_token_here

# Grep.app API (optional)
GREP_API_URL=https://grep.app/api/search
GREP_API_KEY=

# Libraries.io API (optional but recommended for dependents search)
LIBRARIESIO_API_KEY=

# Stack Exchange API (optional)
STACKEXCHANGE_KEY=

# Organization allowlist for filtering (CSV)
# Example: aws-samples,GoogleCloudPlatform,microsoft,openai,tokio-rs
ORG_ALLOWLIST=

# Workspace directory for downloaded archives
ZOO_MCP_WORKSPACE=./workspace

# Maximum response size in bytes (default: 300000 = ~300KB)
ZOO_MCP_MAX_RETURN_BYTES=300000

# WebSocket server options (optional)
# ZOO_MCP_WS_PORT=8080
# ZOO_MCP_WS_HOST=127.0.0.1